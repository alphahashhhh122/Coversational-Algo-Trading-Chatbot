# Copy values into your local environment or an ignored .env file.
# Never commit real credentials.

IIMC_ENVIRONMENT=local
IIMC_DATABASE_PATH=data/iimc_platform.duckdb
IIMC_ARTIFACTS_DIR=artifacts
OPENALGO_ROOT=C:\Users\your-user\openalgo
OPENALGO_BASE_URL=http://127.0.0.1:5000

OPENAI_API_KEY=
OPENALGO_API_KEY=

# Live trading remains disabled unless an explicit production workflow enables it.
IIMC_ALLOW_LIVE_TRADING=false
IIMC_REQUIRE_PAPER_APPROVAL=false
IIMC_LOG_LEVEL=INFO
OPENAI_MODEL=gpt-5.5

MARKET_NEWS_PROVIDER=
MARKET_NEWS_API_URL=
MARKET_NEWS_API_KEY=
MARKET_NEWS_MAX_ARTICLES=10

# Required for multi-user or deployed environments.
IIMC_AUTH_REQUIRED=false
IIMC_AUTH_SECRET=
IIMC_SESSION_TTL_MINUTES=480
IIMC_ALLOWED_HOSTS=127.0.0.1,localhost
IIMC_CORS_ORIGINS=
IIMC_RATE_LIMIT_PER_MINUTE=120
IIMC_MAX_REQUEST_BYTES=1000000

# Optional locally. The Compose stack enables this against its real collector.
IIMC_OTEL_ENABLED=false
OTEL_SERVICE_NAME=iimc-trading-platform
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
IIMC_OTEL_SAMPLE_RATIO=1.0
IIMC_OTEL_EXCLUDED_URLS=live,health,ready,metrics
